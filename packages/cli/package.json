{
  "name": "code-evolution-lab",
  "version": "1.0.0",
  "description": "Evolution-Aware Static Analysis — empirical software diagnostics as code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "code-evolution-lab": "bin/code-evolution-lab.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node bin/code-evolution-lab.js",
    "prepack": "npm --prefix .. run build:core && npm --prefix .. run build:replay && npm run build"
  },
  "dependencies": {
    "@code-evolution/core-engine": "1.0.0",
    "@code-evolution/replay": "1.0.0",
    "commander": "^12.1.0"
  },
  "bundledDependencies": [
    "@code-evolution/core-engine",
    "@code-evolution/replay"
  ],
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "performance",
    "static-analysis",
    "diagnostics",
    "code-evolution",
    "linter",
    "best-practices"
  ],
  "license": "MIT"
}
