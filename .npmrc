# npm publish configuration for @code-evolution scoped packages
# Set registry to npmjs.com (default, explicit for CI clarity)
registry=https://registry.npmjs.org/

# Require authentication for publishing scoped packages
@code-evolution:registry=https://registry.npmjs.org/

# Prevent accidental publish of private/workspace packages
# (override per-package with "private": false in package.json)

# Access level for scoped packages (public = visible on npmjs.com)
access=public

# Provenance — attach build provenance attestation when publishing from CI
# Requires GitHub Actions OIDC token (id-token: write permission)
provenance=true
